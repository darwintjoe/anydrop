# AnyDrop environment template — copy to .env and adjust (`.env` is gitignored, this file is not)

# SQLite database location (Prisma). Relative paths resolve against prisma/schema.prisma.
DATABASE_URL="file:./db/custom.db"

# Default AnyDrop server URL baked into the Chrome extension zip when you run:
#   python3 scripts/build_extension.py
# Leave empty to let users paste their server URL on first launch.
# A real environment variable DEFAULT_SERVER_URL wins over this value.
# Example: DEFAULT_SERVER_URL=https://drop.example.com
DEFAULT_SERVER_URL=
