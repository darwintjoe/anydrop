{
  "manifest_version": 3,
  "name": "AnyDrop — phone ⇄ Chrome drop",
  "version": "1.0.0",
  "description": "The Edge Drop successor: pair your phone with Chrome via a room code and drop text, links, files and photos between devices.",
  "permissions": ["storage", "contextMenus", "alarms", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AnyDrop",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
